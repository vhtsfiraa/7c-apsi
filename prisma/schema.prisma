generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model member {
  ID_Member     String       @id @default(dbgenerated("'MBR-'::text || upper(substr(replace(gen_random_uuid()::text, '-'::text, ''::text), 1, 16))")) @db.VarChar(20)
  Nama_Member   String       @db.VarChar(100)
  No_HP         String?      @db.VarChar(20)
  Gender_Member String?      @db.VarChar(20)
  Tgl_Daftar    DateTime     @default(now()) @db.Date
  transactions  transaksi[]

  @@map("MEMBER")
}

model pegawai {
  ID_Pegawai           String       @id @db.VarChar(20)
  Nama_Pegawai         String       @db.VarChar(100)
  Peran                String       @db.VarChar(50)
  transaksiKasir       transaksi[]  @relation("TransaksiKasir")
  transaksiSupervisor  transaksi[]  @relation("TransaksiSupervisor")
  user                 users?

  @@map("PEGAWAI")
}

model transaksi {
  Kode_Transaksi             String           @id @default(dbgenerated("'TRX-'::text || upper(substr(replace(gen_random_uuid()::text, '-'::text, ''::text), 1, 26))")) @db.VarChar(30)
  Tgl_Jam_Transaksi          DateTime         @default(now()) @db.Timestamp(6)
  ID_Member                  String           @db.VarChar(20)
  ID_Kasir                   String           @db.VarChar(20)
  ID_Supervisor              String?          @db.VarChar(20)
  Total_Berat_Kg             Decimal?         @db.Decimal(5, 2)
  Catatan_Pakaian            String?          @db.Text
  Harga_Per_Kg               Int?
  Nilai_Per_Koin             Int?
  Saldo_Koin_Awal            Int?
  Koin_Didapat               Int?
  Koin_Ditukar               Int?
  Waktu_Notifikasi_Selesai   DateTime?        @db.Timestamp(6)
  member                     member           @relation(fields: [ID_Member], references: [ID_Member])
  pegawaiKasir               pegawai          @relation("TransaksiKasir", fields: [ID_Kasir], references: [ID_Pegawai])
  pegawaiSupervisor          pegawai?         @relation("TransaksiSupervisor", fields: [ID_Supervisor], references: [ID_Pegawai])
  statusProses               status_proses[]

  @@index([ID_Member])
  @@index([ID_Kasir])
  @@index([ID_Supervisor])
  @@map("TRANSAKSI")
}

model status {
  ID_Status     String          @id @db.VarChar(20)
  Nama_Status   String          @db.VarChar(50)
  statusProses  status_proses[]

  @@map("STATUS")
}

model status_proses {
  Kode_Transaksi    String     @db.VarChar(30)
  ID_Status         String     @db.VarChar(20)
  Waktu_Status      DateTime   @default(now()) @db.Timestamp(6)
  transaksi    transaksi  @relation(fields: [Kode_Transaksi], references: [Kode_Transaksi])
  status       status     @relation(fields: [ID_Status], references: [ID_Status])

  @@id([Kode_Transaksi, ID_Status])
  @@index([ID_Status])
  @@map("STATUS_PROSES")
}

model users {
  ID_User       String   @id @db.VarChar(20)
  ID_Pegawai    String   @db.VarChar(20)
  Username      String   @unique @db.VarChar(50)
  Password_Hash String   @db.VarChar(255)
  Role          String   @db.VarChar(50)
  pegawai       pegawai  @relation(fields: [ID_Pegawai], references: [ID_Pegawai])

  @@unique([ID_Pegawai])
  @@map("USERS")
}
